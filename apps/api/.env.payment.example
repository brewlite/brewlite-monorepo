# Merge into your private apps/api/.env. Do not commit a real secret.
# Generate a random secret, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional; login issuer must use the same settings if enabled.
# JWT_ISSUER=brewlite
# JWT_AUDIENCE=brewlite-api
PAYMENT_MOCK_RESULT=SUCCESS
