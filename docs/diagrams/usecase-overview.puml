@startuml
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecaseBackgroundColor #F4FAFF
skinparam usecaseBorderColor #35567C
skinparam actorBorderColor #2F3E4E
skinparam noteBackgroundColor #FFFDF2
skinparam noteBorderColor #B59F5B

title BrewLite — Sơ đồ Use-Case Tổng Quan Hệ Thống (Assignment 2 - Task 1.2)

actor "Khách hàng\n(Guest / CUSTOMER)" as C
actor "Nhân viên\n(STAFF — Pha chế & Thu ngân)" as S
actor "Quản trị viên\n(ADMIN)" as A
actor "Cổng thanh toán\n(Mock / VNPay Sandbox)" as Pay
actor "Dịch vụ Email\n(Gmail SMTP OTP)" as Mail

rectangle "Hệ thống BrewLite (Next.js + NestJS + PostgreSQL)" {
  package "Thực đơn & Giỏ hàng" {
    usecase "UC01: Xem thực đơn,\ntìm kiếm & lọc danh mục\n(ẩn món chưa nhập tồn)" as UC01
    usecase "UC02: Xem chi tiết món &\nchọn Size / Topping / Ghi chú" as UC02
    usecase "UC03: Quản lý giỏ hàng\n(Guest / DB / Giỏ POS)" as UC03
  }

  package "Xác thực & Tài khoản" {
    usecase "UC04: Đăng ký email/password\n& xác minh Gmail OTP" as UC04
    usecase "UC05: Đăng nhập, làm mới phiên\n& đăng xuất (JWT Cookie)" as UC05
  }

  package "Đặt hàng & Thanh toán (Khách hàng)" {
    usecase "UC06: Đặt và thanh toán đơn hàng" as UC06
    usecase "UC07: Kiểm tra tồn kho Size\n& tính giá server-side" as UC07
    usecase "UC08: Tạo đơn PENDING &\ngiữ tài nguyên (TTL 10 phút)" as UC08
    usecase "UC09: Thanh toán đơn hàng\n(Mock / VNPay Sandbox)" as UC09
    usecase "UC10: Áp dụng mã giảm giá" as UC10
    usecase "UC11: Dùng điểm thưởng" as UC11
    usecase "UC12: Hủy đơn & hoàn tiền\ntrước khi pha chế" as UC12
    usecase "UC13: Xem lịch sử đơn, trạng thái,\nđiểm thưởng & thông báo" as UC13
  }

  package "Bán tại quầy (POS), Ca thu ngân & Pha chế" {
    usecase "UC14: Mở / Đóng ca thu ngân\n& đếm két (CashShift)" as UC14
    usecase "UC15: Đặt món thay khách trực tiếp\n(tận dụng Thực đơn & Giỏ chung,\nkhông áp dụng mã giảm giá/điểm)" as UC15
    usecase "UC16: Thu tiền tại quầy\n(Tiền mặt hoặc xác nhận Chuyển khoản QR)" as UC16
    usecase "UC17: Hủy đơn & hoàn tiền tại quầy\n(ghi sổ ca & lý do bắt buộc)" as UC17
    usecase "UC18: Xử lý đơn cần phục vụ\n(PAID → PREPARING → READY → COMPLETED)" as UC18
  }

  package "Quản trị cửa hàng (ADMIN)" {
    usecase "UC19: Quản lý thực đơn &\nkhởi tạo/cập nhật tồn kho Size" as UC19
    usecase "UC20: Quản lý khuyến mãi\n& người dùng (RBAC)" as UC20
    usecase "UC21: Giám sát đơn hàng &\nhồ sơ tài khoản (chỉ đọc)" as UC21
    usecase "UC22: Đối soát tiền mặt &\nthu quỹ cuối ca (RECONCILED)" as UC22
  }
}

' Khách hàng
C -- UC01
C -- UC02
C -- UC03
C -- UC04
C -- UC05
C -- UC06
C -- UC12
C -- UC13

' Nhân viên (STAFF)
S -- UC01
S -- UC02
S -- UC03
S -- UC05
S -- UC14
S -- UC15
S -- UC16
S -- UC17
S -- UC18

' Quản trị viên (ADMIN)
A -- UC05
A -- UC19
A -- UC20
A -- UC21
A -- UC22

' Hệ thống ngoài
UC04 -- Mail
UC09 -- Pay
UC16 -- Pay

' Quan hệ Include / Extend
UC06 ..> UC07 : <<include>>
UC06 ..> UC08 : <<include>>
UC06 ..> UC09 : <<include>>
UC10 ..> UC06 : <<extend>>\n[có mã giảm giá]
UC11 ..> UC06 : <<extend>>\n[CUSTOMER dùng điểm]
UC04 ..> UC06 : <<extend>>\n[chưa đăng nhập - đăng ký]
UC05 ..> UC06 : <<extend>>\n[chưa đăng nhập - đăng nhập]

UC15 ..> UC07 : <<include>>
UC15 ..> UC08 : <<include>>
UC15 ..> UC16 : <<include>>

note bottom of UC16
  Tại quầy chỉ có 2 phương thức: Tiền mặt (cần CashShift OPEN)
  và Chuyển khoản QR (hiện mã QR, nhân viên kiểm tra & xác nhận trực tiếp).
  Không áp dụng mã giảm giá/điểm thưởng; không dùng VNPay; không thu hộ đơn online.
end note

note right of A
  ADMIN chỉ giám sát đơn hàng, không chuyển
  trạng thái pha chế và không tự duyệt payment SUCCESS.
  Sau khi đối soát ca (RECONCILED), sổ ca bị khóa bất biến.
end note
@enduml
