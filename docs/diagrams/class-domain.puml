@startuml
!pragma layout smetana
!theme plain
title BrewLite — Domain theo Prisma hiện tại
hide methods
class User {
 id: UUID
 email: string
 passwordHash: string
 emailVerifiedAt: DateTime?
 role: UserRole
 loyaltyPoints: int
 reservedPoints: int
}
class Product {
 id: UUID
 name: string
 basePrice: Decimal
 imageUrl: string?
 isAvailable: boolean
}
class Category {
 id: UUID
 name: string
 isActive: boolean
}
class Size {
 id: UUID
 name: string
 extraPrice: Decimal
 onHand: int?
 reserved: int
 version: int
}
class Topping {
 id: UUID
 name: string
 price: Decimal
 isAvailable: boolean
}
class Cart {
 id: UUID
 version: int
}
class CartItem {
 id: UUID
 quantity: int
 configurationKey: string?
 requiresConfiguration: boolean
 note: string?
}
class Order {
 id: UUID
 orderCode: string
 status: OrderStatus
 finalTotal: Decimal
 expiresAt: DateTime?
 version: int
 checkoutCartSnapshot: Json?
}
class OrderItem {
 productName: string
 sizeName: string
 unitPrice: Decimal
 quantity: int
 lineTotal: Decimal
}
class Payment {
 id: UUID
 method: PaymentMethod
 amount: Decimal
 status: PaymentStatus
 attemptNumber: int?
 transactionRef: string?
}
class Refund {
 id: UUID
 amount: Decimal
 provider: string
 status: RefundStatus
 idempotencyKey: string <<unique>>
 providerRefundId: string?
}
enum RefundStatus {
 REQUESTED
 PENDING
 SUCCESS
 FAILED
 UNKNOWN
}
class PaymentEvent {
 providerEventId: string <<unique>>
 processingStatus: string
}
class Promotion {
 code: string
 discountValue: Decimal
 usageLimit: int
 usedCount: int
 reservedCount: int
}
class LoyaltyTransaction {
 type: EARN|REDEEM|REFUND|EARN_REVERSAL
 points: int
 balanceAfter: int
}
class OrderReservation {
 state: HELD|CONSUMED|RELEASED
 expiresAt: DateTime
}
class OrderStatusHistory {
 fromStatus: OrderStatus?
 toStatus: OrderStatus
 orderVersion: int
}
enum UserRole {
 CUSTOMER
 STAFF
 ADMIN
}
enum OrderStatus {
 PENDING
 PAYMENT_FAILED
 PAID
 PREPARING
 READY
 COMPLETED
 CANCELLED
}
enum PaymentStatus {
 PENDING
 UNKNOWN
 SUCCESS
 FAILED
}
Category "0..1" -- "0..*" Product
Product "1" -- "0..*" Size
User "0..1" -- "0..1" Cart
Cart "1" *-- "0..*" CartItem
CartItem "0..*" -- "1" Product
CartItem "0..*" -- "0..1" Size
CartItem "0..*" -- "0..*" Topping : CartItemTopping
User "0..1" -- "0..*" Order
Order "1" *-- "1..*" OrderItem
OrderItem "0..*" -- "1" Product
OrderItem "0..*" -- "0..1" Size
Order "1" -- "0..*" Payment
Payment "1" *-- "0..*" PaymentEvent
Payment "1" -- "0..1" Refund
Promotion "0..1" -- "0..*" Order
Order "0..1" -- "0..*" LoyaltyTransaction
User "1" -- "0..*" LoyaltyTransaction
Order "1" -- "0..1" OrderReservation
Order "1" *-- "0..*" OrderStatusHistory
note bottom of Size
Available = onHand - reserved.
onHand NULL: chưa nhập tồn, không bán.
Không dùng Product.stockQuantity legacy.
end note
@enduml
