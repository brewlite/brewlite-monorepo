# Replace SITE_DOMAIN in deploy/.env.production with a real DNS hostname.
# Caddy automatically obtains and renews HTTPS certificates when DNS/ports work.
{$SITE_DOMAIN} {
    encode zstd gzip
    # Access logging without payment query strings, cookies or headers.
    # Correlate timestamps with Nest's vnpay.ipn / vnpay.querydr events.
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers delete
                resp_headers delete
            }
        }
    }

    @vnpay_ipn path /api/payments/vnpay/ipn
    log_append @vnpay_ipn endpoint vnpay-ipn

    # Preserve the /api prefix expected by NestJS (do not use handle_path here).
    handle /api/* {
        reverse_proxy api:3001
    }

    handle {
        reverse_proxy web:3000
    }
}
