# TEMPLATE ONLY. Do not use the example as-is, upload secrets, or commit the actual file.
# Choose a real domain (without https://). Its DNS A record must point to EC2 public IP.
SITE_DOMAIN=

# Use a new, strong production database password. To keep the DATABASE_URL simple,
# generate an alphanumeric/hex password; otherwise URL-encode special characters.
POSTGRES_USER=brewlite_user
POSTGRES_DB=brewlite_db
POSTGRES_PASSWORD=
# Replace username/password/database consistently; host MUST be postgres:5432.
DATABASE_URL=

# Generate at least 32 random bytes; NEVER reuse the Windows development secret.
JWT_SECRET=

# Real Gmail SMTP credentials (or configured SMTP provider), if auth/OTP is enabled.
SMTP_USER=
SMTP_PASS=

# VNPay Sandbox. Leave unset until provided by VNPay.
# Return URL will look like https://YOUR_DOMAIN/api/payments/vnpay/return
# IPN  URL will look like https://YOUR_DOMAIN/api/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_SERVER_IP=
VNPAY_RECONCILE_ENABLED=false
ENABLE_MOCK_PAYMENTS=true
MOCK_PAYMENT_OUTCOME=SUCCESS
